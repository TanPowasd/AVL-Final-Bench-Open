      }
    },
    "ind": {
      "kappa_ind": 0.35,
      "beta_transit": 0.05,
      "rho_nfa_per_cycle": 0.01,
      "eta_sink": {
        "inventory_scope": "owned_physical_stock_all_locations_plus_nonproductive_sink_debt; sink debt persists through match, not a physical asset",
        "consumption_window_cycles": 20,
        "consumption_floor": 1.0,
        "full_credit_ratio": 6.0,
        "zero_credit_ratio": 12.0,
        "formula": "1.0 if chi <= 6.0 else max(0.0, 1.0 - (chi - 6.0)/6.0)",
        "consumption_definition": "逐国家p逐物品g统计合资格民生/非敌对生产科研环保消费；施工按25%非施工上限；所有军事行动、敌对行为、修理资本化、出口/转仓/弃货不计消纳。"
      },
      "va_rule": "非采掘产线有符号VA_eff=batch*(sum(eligible_output*w*eta)-sum(input*w)); ACTION_LOSS用途流量无正产出；Loss_destroy与Loss_action各按唯一事件在国家工业支柱扣一次，维修只资本化",
      "transit_definition": "TransitReceipt[p,e]=(q_mU/1000)*w_cat[g]*min(D0_L1_cells,L_total)*L_p/L_total; L_total=0=>0; NetTransit=rolling20sum/20; action/repair/nonterminal uses excluded",
      "action_loss": {
        "formula": "Loss_action(p,c)=sum_{distinct executed events e of p in c} max(0.001, sum_g actual_consumption[e,g]*w_cat[g])",
        "floor_catalog_value": 0.001,
        "coefficient": 1.0,
        "scope": [
          "all_firing_including_defense",
          "all_military_movement_including_patrol",
          "blockade_interdiction",
          "cyber_attack",
          "decoy",
          "cryptanalysis",
          "asat",
          "hypersonic_strike",
          "unconsented_climate_intervention",
          "hostile_acl_embargo_expropriation",
          "declare_war"
        ],
        "eta_denominator": false,
        "terminal_receipts": false,
        "book_added": false,
        "floor_rationale": "公开的最小行动损耗，不是新增现金/商品；覆盖零弹药近战、无物料政策攻击等零消耗分支。实际耗材已大于底额时不另叠加。"
      },
      "extraction_rule": "采掘不进入VA_eff求和；只通过有成本的下游生产、物权库存、实际交易和sigma体现，不给自然资源开采额外目录增加值。",
      "transit_units": "catalog_value * L1_path_cells / cycle"
    },
    "ctrl": {
      "kappa_ctrl": 1.0,
      "sigma_region": {
        "extract_coeff": 0.05,
        "powered_slot_coeff": 0.5,
        "chokepoint_flow_coeff": 0.02,
