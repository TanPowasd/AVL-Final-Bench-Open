      "q_life": {
        "food_gate_fn": "f_food(s) = 0.80*(s/0.80)^2 if s < 0.80 else 0.80 + 0.20*min(1.0, (s - 0.80)/0.20)",
        "composite_fn": "Q_life = clip(f_food(s_food_qual) * (0.55 + 0.35*sqrt(min(2.0, s_cons)) + 0.25*sqrt(min(2.0, s_med)) + 0.15*s_util), 0.0, 1.50)",
        "weights": {
          "base_survival": 0.55,
          "consumer_goods_sqrt": 0.35,
          "medicine_sqrt": 0.25,
          "utilities_linear": 0.15
        },
        "synthetic_food_cap_rule": "if synthetic_food_share > 0.30: s_food_qual = min(s_food, 1.0 - 0.30*(synthetic_food_share - 0.30)/0.70)",
        "clip": [
          0.0,
          1.5
        ]
      },
      "q_sec": {
        "combat_coeff": 0.4,
        "blockade_coeff": 0.3,
        "pollute_coeff": 0.5,
        "v02_remediation_reduction": 0.5,
        "clip": [
          0.0,
          1.0
