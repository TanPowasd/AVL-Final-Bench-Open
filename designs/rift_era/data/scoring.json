      "rolling_net_trade_window_cycles": 20,
      "city_state_weight_formula": "clip(0.5+0.02*Pop_m(0)+0.02*sum(w_cat[g]*Q_extract_initial[m,g]),0.5,2)",
      "city_state_align_formula": "Align_{m<-p}(c) = 1.0 if p is active partner of city-state m under 03 §3 hysteresis (J_m(p) >= 0.35) else 0.0",
      "realized_aid_formula": "mean20(irrevocably_consumed_goods_granted_to_city_states*w_cat); cash excluded; same receipt cannot count both trade and aid",
      "credit_range": [
        0.1,
        1.0
      ],
      "trade_definition": "不可逆末端使用时向原产国计目录出口，原产国=使用国则0；无出口预计/回购回吐。服务按真实跨境使用，固定w_cat[electricity/compute]。",
      "formula": ".08*mean20(Credit_at_use*confirmed_exports)+2.5*Credit_current*sum(omega*Align)+.05*mean20(Credit_at_use*confirmed_aid)"
    }
